# ============================================
# DATABASE CONFIGURATION
# ============================================
# Used by: Backend (TypeORM) and Docker (PostgreSQL)
# IMPORTANT: These values must match docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=backend_user
DB_PASSWORD=change_this_secure_password
DB_DATABASE=db_agrosoft

# Docker-specific port mapping (external:internal)
# This maps host port 5433 to container port 5432
POSTGRES_PORT_EXTERNAL=5433

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# CORS CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# TYPEORM CONFIGURATION
# ============================================
# WARNING: Set to false in production. Use migrations instead.
# true = Auto-sync schema (DEVELOPMENT ONLY)
# false = Use migrations (PRODUCTION)
DB_SYNCHRONIZE=true
DB_LOGGING=true
