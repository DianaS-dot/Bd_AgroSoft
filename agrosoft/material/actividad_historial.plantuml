   id: integer
}
class epa_tipos_cultivos_wiki {
   epaId: integer
   tipoCultivoWikiId: integer
}
class epas {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   nombre: varchar
   tipoEpa: varchar
   descripcion: text
   sintomas: text
   manejoYControl: text
   mesesProbables: integer[]
   temporadas: text[]
   notasEstacionalidad: text
   fotosSintomas: text[]
   fotosGenerales: text[]
   tags: text[]
   creadoPorUsuarioId: integer
   id: integer
}
class facturas {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
