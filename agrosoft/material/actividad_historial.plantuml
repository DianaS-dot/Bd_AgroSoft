   areaHa: numeric(12,4)
   centroide: geometry(point,4326)
   descripcion: varchar
   estado: varchar
   id: integer
}
class node45 as "telegram_form_estado  /* Tabla para mantener el estado de los formularios del bot de T... */" {
   user_id  /* ID del usuario de Telegram (único) */: bigint
   step  /* Paso actual en el formulario */: integer
   data  /* Datos del formulario en formato JSON */: jsonb
   estado  /* Estado del formulario (activo, logged_in, etc.) */: varchar(20)
   updated_at  /* Fecha y hora de última actualización */: timestamp
   access_token  /* Token de acceso para autenticación */: text
   id  /* Identificador único autoincremental */: integer
}
