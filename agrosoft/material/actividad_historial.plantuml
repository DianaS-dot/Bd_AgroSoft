   pdfUrl: varchar
   id: integer
}
class historial_precios_lote {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   loteProduccionId: integer
   precioAnterior: double precision
   precioNuevo: double precision
   usuarioId: integer
   fecha: timestamp
   razon: varchar
   id: integer
}
class insumos {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   nombre: varchar
   descripcion: text
   fotoUrl: varchar
   presentacionTipo: varchar
   presentacionCantidad: double precision
   presentacionUnidad: varchar
   unidadUso: varchar
   tipoMateria: varchar
   factorConversionUso: double precision
   stockPresentacion: double precision
   stockUso: double precision
   precioUnitarioPresentacion: double precision
   precioUnitarioUso: double precision
   valorInventario: double precision
   almacenId: integer
   proveedorId: integer
   categoriaId: integer
   fechaRegistro: timestamp
   creadoPorUsuarioId: integer
   tipoInsumo: insumos_tipoinsumo_enum
   costoAdquisicion: double precision
   valorResidual: double precision
   vidaUtilHoras: double precision
   horasUsadas: double precision
   stockReservado: double precision
   depreciacionAcumulada: double precision
   stockMinimo: integer
   estado: insumos_estado_enum
   costoUnitario: numeric(10,2)
   fechaAdquisicion: date
   fechaUltimoMantenimiento: date
   fechaBaja: date
   id: integer
}
class iot_global_config {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   name: varchar
   broker: varchar
   port: integer
   protocol: varchar
   topic_prefix: varchar
   default_topics: text
   custom_topics: text
   lote_id: integer
   sub_lote_id: integer
   username: varchar
   password: varchar
   activo: boolean
   default_sensors_initialized: boolean
   auto_discover: boolean
   id: integer
}
class lotes {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   nombre: varchar
   geom: geometry(polygon,4326)
   areaM2: numeric(12,2)
   areaHa: numeric(12,4)
   centroide: geometry(point,4326)
   descripcion: varchar
   estado: varchar
   id: integer
}
class lotes_produccion {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
