@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

class actividad_historial {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   actividadId: integer
   usuarioId: integer
   motivo: text
   cambios: jsonb
   id: integer
}
class actividad_insumos {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   actividad_id: integer
   insumo_id: integer
   cantidad_usada: double precision
   unidad: varchar
   costo_unitario: double precision
   costo_total: double precision
   actividadId: integer
   insumoId: integer
   id: integer
}
class actividades {
   created_at: timestamp
   updated_at: timestamp
   deleted_at: timestamp
   nombre: varchar
   tipo: varchar
   subtipo: varchar
   loteId: integer
   subLoteId: integer
   cultivoId: integer
   fecha: timestamp
   horasActividad: double precision
   precioHoraActividad: double precision
   costoManoObra: double precision
   descripcion: text
   estado: varchar
   creado_por_usuario_id: integer
   cantidadPlantas: integer
   kgRecolectados: double precision
   productoAgroId: integer
   id: integer
}
